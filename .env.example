# .env.example
#
# Contoh isi berkas `.env`. Berkas INI boleh masuk git; `.env` yang sebenarnya
# TIDAK — ia berisi kredensial, dan nilainya berbeda antara laptop dan server.
#
# Cara pakai: salin berkas ini menjadi `.env`, lalu isi nilainya.
#   Windows : copy .env.example .env
#   cPanel  : buat lewat File Manager, atau lewat "Setup Node.js App" >
#             Environment variables.

# ----------------------------------------------------------------- Database
# Di laptop  : localhost / root / password kosong / port 3307 (XAMPP)
# Di cPanel  : host localhost, tetapi user dan nama database DIBERI PREFIKS
#              nama akun cPanel (mis. namaakun_kharisma), password dibuat
#              sendiri di menu MySQL Databases, dan portnya biasanya 3306.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=3306

# ------------------------------------------------------------ Rahasia sesi
# Menandatangani token login. WAJIB diisi dan minimal 16 karakter.
#
# Bila dikosongkan, server membuat rahasia acak baru setiap kali menyala —
# artinya SEMUA pengguna terlempar keluar setiap aplikasi dimulai ulang. Di
# cPanel, Passenger memulai ulang aplikasi cukup sering, jadi ini akan sangat
# terasa.
#
# Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Nilainya HARUS BERBEDA antara laptop dan server, dan jangan pernah
# dibagikan atau di-commit.
SESSION_SECRET=

# ------------------------------------------------------------------- Lainnya
VITE_PUBLIC_BUILDER_KEY=
PING_MESSAGE=

# --------------------------------------------------------- Integrasi FASIH
# Dikosongkan = belum tersambung, dan seluruh kegiatan memakai progres yang
# diisi PML secara manual. Mengisinya membuat kegiatan bertanda FASIH mengambil
# progres dari sana; mengosongkannya lagi mengembalikan semuanya ke manual,
# tanpa perlu menyunting kode.
#
# Rincian kebutuhan dan langkah penyambungan: docs/integrasi-fasih.md
FASIH_BASE_URL=
FASIH_TOKEN=
