@startuml activity-proses-usulan
' Pengganti Gambar 7 (Activity Diagram alur proses bisnis usulan).
' Gambaran umum satu siklus kegiatan. Rincian tiap proses ada di 03 s.d. 07.
!include _gaya.iuml

' UKURAN HURUF DAN PEMENGGALAN LABEL — jangan dikembalikan ke satu baris.
'
' Alasannya sama dengan 13-proses-bisnis-berjalan.puml: empat lajur membuat
' gambarnya lebar, sehingga tulisannya mengecil ketika dipasang selebar halaman.
' Terukur: pada bentuk lamanya, huruf 12 pt di dalam gambar selebar 1234 piksel
' hanya setara 4,41 pt pada lebar cetak 16 cm.
'
' Memperbesar huruf saja tidak menolong karena kotaknya ikut melebar. Yang
' menolong adalah mempersempit lajur dengan memenggal label menjadi lebih banyak
' baris pendek, sehingga gambarnya memanjang ke bawah.
skinparam defaultFontSize 15
skinparam activityFontSize 15
skinparam activityDiamondFontSize 14
skinparam swimlaneTitleFontSize 16

' Garis penutup atas, bawah, dan pemisah judul ditambahkan ke SVG hasil ekspor
' oleh alat/tutup_swimlane.py, yang WAJIB dijalankan ulang setiap kali diagram
' ini diekspor ulang.

|Ketua Tim|
start
:Membuat kegiatan
beserta jadwal dan
dokumen wajib;

repeat
  |Ketua Tim|
  :Mengalokasikan mitra,
  PML, beban kerja,
  dan harga;
  |Sistem|
  :Membagi muatan
  per bulan dan
  memeriksa batas SBML;
repeat while (Melebihi batas\nSBML dan\ndirevisi?) is (ya) not (tidak)

|Sistem|
:Menyimpan kegiatan,
alokasi, dan honor
per bulan;

fork
  |Tim Keuangan|
  :Membuat SPK
  mitra per bulan
  (PDF);
fork again
  |PML|
  :Menginput progres
  pekerjaan mitra;
fork again
  |Ketua Tim|
  :Mengisi tautan
  dokumen
  setiap tahap;
end fork

|Sistem|
:Memperbarui dasbor
dan notifikasi;

|Tim Keuangan|
repeat
  :Memeriksa
  kelengkapan
  dan keabsahan
  dokumen;
  if (Dokumen valid?) then (ya)
    :Menyetujui
    dokumen;
  else (tidak)
    :Menolak
    dokumen
    dengan catatan;
    |Sistem|
    :Mengirim notifikasi
    penolakan;
    |Ketua Tim|
    :Memperbaiki tautan
    dokumen;
  endif
  |Tim Keuangan|
repeat while (Masih ada\ndokumen\nbelum\ndisetujui?) is (ya) not (tidak)

:Membuat BAST mitra
(PDF);

|PML|
:Menilai kinerja
mitra (3 aspek,
skala 1–10);

|Sistem|
:Menghitung peringkat
mitra per triwulan;
stop

@enduml
