@startuml activity-proses-usulan
' Pengganti Gambar 7 (Activity Diagram alur proses bisnis usulan).
' Gambaran umum satu siklus kegiatan. Rincian tiap proses ada di 03 s.d. 07.
!include _gaya.iuml

|Ketua Tim|
start
:Membuat kegiatan beserta
jadwal dan dokumen wajib;

repeat
  |Ketua Tim|
  :Mengalokasikan mitra, PML,
  beban kerja, dan harga;
  |Sistem|
  :Membagi muatan per bulan
  dan memeriksa batas SBML;
repeat while (Melebihi batas SBML\ndan direvisi?) is (ya) not (tidak)

|Sistem|
:Menyimpan kegiatan, alokasi,
dan honor per bulan;

fork
  |Tim Keuangan|
  :Membuat SPK mitra
  per bulan (PDF);
fork again
  |PML|
  :Menginput progres
  pekerjaan mitra;
fork again
  |Ketua Tim|
  :Mengisi tautan dokumen
  setiap tahap;
end fork

|Sistem|
:Memperbarui dasbor
dan notifikasi;

|Tim Keuangan|
repeat
  :Memeriksa kelengkapan dan
  keabsahan dokumen;
  if (Dokumen valid?) then (ya)
    :Menyetujui dokumen;
  else (tidak)
    :Menolak dokumen
    dengan catatan;
    |Sistem|
    :Mengirim notifikasi
    penolakan;
    |Ketua Tim|
    :Memperbaiki tautan dokumen;
  endif
  |Tim Keuangan|
repeat while (Masih ada dokumen\nbelum disetujui?) is (ya) not (tidak)

:Membuat BAST mitra (PDF);

|PML|
:Menilai kinerja mitra
(3 aspek, skala 1–10);

|Sistem|
:Menghitung peringkat
mitra per triwulan;
stop

@enduml
