@startuml activity-alokasi-sbm
' Rincian use case "Membuat/Menyunting Kegiatan & Alokasi Mitra"
' beserta "Validasi Batas Honor (SBML)".
'
' Sesuai kode:
'  - pelanggaran batas TIDAK ditolak mutlak: server menjawab 409
'    HONOR_LIMIT_EXCEEDED, layar memberi peringatan, pengguna boleh melanjutkan;
'  - yang dibagi ke bulan adalah MUATAN (unit beban kerja), honor per bulan
'    = volume x harga satuan (shared/pembebananHonor.ts);
'  - simpan dari Edit Kegiatan membawa `versi`; bila kegiatan sudah disimpan
'    orang lain sejak halaman dibuka, server menolak dengan 409.
!include _gaya.iuml

|Ketua Tim|
start
:Membuka halaman Kegiatan Baru
atau Edit Kegiatan;
:Mengisi informasi kegiatan,
jadwal, dan tahap yang dipakai;
:Mengisi satuan beban kerja
dan harga satuan;

repeat
  |Ketua Tim|
  :Menekan Pilih dari
  Daftar PPL;
  |Sistem|
  :Menampilkan mitra aktif
  yang sesuai tahap;
  |Ketua Tim|
  :Menyaring mitra per kecamatan
  dan desa, lalu memilihnya;
  :Mengisi PML dan beban
  kerja tiap mitra;
  :Memilih metode pembebanan;
  :Menekan tombol Simpan;
  |Sistem|
  :Menghitung honor dan membagi
  muatan ke bulan pembebanan;
  :Menjumlahkan honor mitra
  dari seluruh kegiatan;
  if (Melebihi batas SBML?) then (ya)
    :Menampilkan peringatan
    beserta rinciannya;
    |Ketua Tim|
    if (Tetap lanjutkan?) then (ya)
      :Mengonfirmasi tetap
      menyimpan;
    else (tidak)
      :Merevisi alokasi;
    endif
  else (tidak)
  endif
  |Sistem|
repeat while (Ketua Tim merevisi alokasi?) is (ya) not (tidak)

if (Sudah diubah\norang lain?) then (ya)
  :Menolak dan meminta
  muat ulang halaman;
  stop
else (tidak)
endif

:Menyimpan seluruh data
dalam satu transaksi;
:Menaikkan versi dan membuat
daftar dokumen wajib;
:Mencatat riwayat kegiatan;
stop


@enduml
