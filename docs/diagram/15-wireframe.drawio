        </mxCell>
        <mxCell id="w16b-65" value="Wilayah pada berkas PALAPA berupa KODE BPS tanpa nama. Sistem mencocokkannya sendiri lewat kode, dan nama dipakai hanya sebagai cadangan." style="shape=note;whiteSpace=wrap;html=1;fontFamily=Arial;size=12;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="356" y="520" width="310" height="68" as="geometry" />
        </mxCell>
        <mxCell id="w16b-66" value="Peninjauan tidak mengubah apa pun. Setelah &quot;Lanjut&quot;, masih ada langkah penonaktifan mitra yang tidak ada di berkas." style="shape=note;whiteSpace=wrap;html=1;fontFamily=Arial;size=12;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;" vertex="1" parent="1">
