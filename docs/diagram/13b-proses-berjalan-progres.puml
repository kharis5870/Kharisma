' Lanjutan dari 13a; lihat alasan pemisahan di berkas tersebut.
!include _gaya.iuml

|#F6FFF7|PML|
|#F7FAFF|Ketua Tim|
|#FFFDF2|Tim Keuangan|
|#FFF7F7|Perekap Penilaian|

|PML|
start
if (Kegiatan memakai\naplikasi FASIH?) then (ya)
  :Memeriksa progres mitra
  di aplikasi FASIH;
else (tidak)
  :Mencatat progres mitra
  di spreadsheet;
endif

|Ketua Tim|
:Memantau progres lewat
FASIH atau spreadsheet;

repeat
  :Mengumpulkan dokumen
  kegiatan ke folder daring;

  |Tim Keuangan|
  :Memeriksa kelengkapan dokumen;
repeat while (Dokumen sudah lengkap?) is (belum) not (lengkap)

:Memastikan tugas SPK
sudah diselesaikan;
:Mengetik dan menomori
BAST satu per satu;
:Memproses pencairan honor;

|PML|
:Mengisi nilai mitra
di spreadsheet;

|Perekap Penilaian|
:Menghitung peringkat mitra
per triwulan secara manual;
stop
