@startuml usecase-keuangan
' Use Case Diagram bagian 2/3: administrasi dan keuangan.
'
' Lihat 01a-usecase-kegiatan.puml untuk alasan pemecahan dan catatan aktor.
'
' "Tim Keuangan" adalah role supervisor di tabel users — bukan role tersendiri.
!include _gaya.iuml
left to right direction

actor "Tim Keuangan" as TK

rectangle "SIKAMI — Administrasi dan Keuangan" {

  package "Administrasi & Keuangan" {
    usecase "Mengatur Batas\nHonor Bulanan (SBML)" as UC_BATAS
    usecase "Memverifikasi\nDokumen" as UC_VERIF
    usecase "Menolak Dokumen\ndengan Catatan" as UC_TOLAK
    usecase "Mengirim Pengingat\nDokumen" as UC_INGAT
    usecase "Mengatur Penanggung\nJawab Dokumen" as UC_PJ
    usecase "Mengelola Template\nSurat" as UC_TEMPLATE
    usecase "Membuat Surat Perjanjian\nKerja (SPK) per Bulan" as UC_SPK
    usecase "Membuat BAST" as UC_BAST
    usecase "Melihat Riwayat\nPenyuratan" as UC_RIWSURAT
    usecase "Memperbarui\nIsi Surat" as UC_PERBARUI
    usecase "Membatalkan /\nMenghapus Surat" as UC_BATALSURAT
    usecase "Mengubah, Merapikan, atau\nMengatur Ulang Nomor Surat" as UC_NOMOR
  }
}

TK --> UC_BATAS
TK --> UC_VERIF
TK --> UC_INGAT
TK --> UC_PJ
TK --> UC_TEMPLATE
TK --> UC_SPK
TK --> UC_BAST
TK --> UC_RIWSURAT
TK --> UC_PERBARUI
TK --> UC_BATALSURAT
TK --> UC_NOMOR

UC_TOLAK ..> UC_VERIF : <<extend>>

' Mengapung, bukan `note bottom` — lihat catatan di 01a-usecase-kegiatan.puml.
note as CATATAN_PEWARISAN
  Tim Keuangan juga mewarisi seluruh use case
  Pegawai pada gambar sebelumnya.
end note

@enduml
