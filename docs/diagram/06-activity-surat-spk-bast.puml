@startuml activity-surat-spk-bast
' Rincian use case "Membuat SPK per Bulan" dan "Membuat BAST"
' (menu Keuangan > Generate Surat).
'
' Sesuai kode:
'  - periode SELALU satu bulan kalender, diturunkan dari pilihan bulan;
'  - satu surat AKTIF per mitra per bulan (kontrak_mitra.kunci_aktif);
'  - nomor diberikan di bawah kunci penomoran per tahun, sehingga dua orang
'    yang menekan Generate bersamaan tidak mendapat nomor kembar;
'  - nomor BAST mengikuti nomor urut SPK mitra yang sama.
!include _gaya.iuml

|Tim Keuangan|
start
:Membuka menu Generate Surat
dan memilih bulan honor;

|Sistem|
:Menetapkan periode satu bulan kalender penuh;
:Menampilkan mitra yang memiliki muatan pada bulan
tersebut beserta rincian kegiatan, volume, dan honornya;

|Tim Keuangan|
:Melengkapi uraian tugas dan
kode beban anggaran (MAK);

partition "Surat Perjanjian Kerja (SPK)" {
  :Memesan nomor SPK;
  |Sistem|
  if (Mitra sudah memiliki surat\naktif pada bulan ini?) then (ya)
    :Memakai nomor yang sama;
  else (tidak)
    :Mengunci penomoran tahun berjalan dan
    memberi nomor urut berikutnya
    sesuai pola nomor di template;
  endif
  :Menyimpan data surat beserta
  salinan isi surat saat terbit;
  :Menyusun PDF SPK dari template surat;
  |Tim Keuangan|
  :Mengunduh dan mencetak SPK;
}

partition "Berita Acara Serah Terima (BAST)" {
  :Memilih tanggal BAST;
  |Sistem|
  if (SPK mitra sudah dibuat?) then (tidak)
    :Menandai mitra sebagai
    belum memiliki SPK;
  else (ya)
    :Memberi nomor BAST yang mengikuti
    nomor urut SPK mitra tersebut;
    :Menyusun PDF BAST;
    |Tim Keuangan|
    :Mengunduh dan mencetak BAST;
  endif
}
stop

@enduml
