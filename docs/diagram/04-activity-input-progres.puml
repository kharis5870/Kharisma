@startuml activity-input-progres
' Rincian use case "Menginput Progres Mitra".
' Hak akses: bolehMemperbaruiProgress (PML mitra tersebut, ditambah admin).
' Masa pengisian: progresBolehDiperbarui -- tertutup selama tahap persiapan,
' terbuka sejak hari pertama pengumpulan data dan tidak ditutup lagi setelahnya.
!include _gaya.iuml

|PML|
start
:Membuka Dashboard dan
memilih kegiatan;
:Memilih mitra yang diawasi;

|Sistem|
if (Masa pengumpulan data\nsudah dimulai?) then (belum)
  :Menolak: progres baru dapat diisi
  setelah masa pendataan dimulai;
  stop
else (sudah)
endif

if (Pengguna adalah PML mitra\ntersebut atau admin?) then (tidak)
  :Menolak: progres hanya dapat
  diperbarui oleh PML-nya;
  stop
else (ya)
endif

repeat
  |PML|
  :Mengisi jumlah dokumen
  per status tiap tahap;
  |Sistem|
  :Menghitung sisa dari beban
  kerja dikurangi status lain;
repeat while (Melebihi beban kerja?) is (ya) not (tidak)

:Menyimpan progres mitra;
:Memperbarui persentase progres kegiatan;
:Mencatat riwayat kegiatan;
:Memperbarui grafik dan
tabel dasbor;
stop

@enduml
