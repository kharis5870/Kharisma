@startuml activity-usulan-b
' Gambar 7b: alur proses bisnis sistem usulan, bagian 2 -- dari verifikasi
' dokumen sampai penilaian dan peringkat mitra per triwulan.
' Lanjutan dari 02a; lihat alasan pemisahan di berkas tersebut.
!include _gaya.iuml

|Tim Keuangan|
start
repeat
  :Memeriksa kelengkapan dan
  keabsahan dokumen;
  if (Dokumen valid?) then (ya)
    :Menyetujui dokumen;
  else (tidak)
    :Menolak dokumen
    dengan catatan;
    |Sistem|
    :Mengirim notifikasi
    penolakan;
    |Ketua Tim|
    :Memperbaiki tautan dokumen;
  endif
  |Tim Keuangan|
repeat while (Masih ada dokumen\nbelum disetujui?) is (ya) not (tidak)

:Membuat BAST mitra (PDF);

|PML|
:Menilai kinerja mitra
(3 aspek, skala 1–10);

|Sistem|
:Menghitung peringkat
mitra per triwulan;
stop
@enduml
