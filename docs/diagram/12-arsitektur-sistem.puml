@startuml arsitektur
' Diagram Arsitektur Sistem untuk Bab V (5.1.1).
' Menggambarkan penempatan (deployment) dan aliran data antar komponen.
!include _gaya.iuml

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF4FB
  BorderColor #2F4F75
}
skinparam node {
  BackgroundColor #FBFBFB
  BorderColor #555555
}
skinparam database {
  BackgroundColor #EEF4FB
  BorderColor #2F4F75
}
skinparam cloud {
  BackgroundColor #F7F7F7
  BorderColor #777777
}

node "Komputer Pengguna\n(Jaringan BPS / FortiClient VPN)" as KLIEN {
  component "Peramban Web" as BROWSER {
    component "Antarmuka SIKAMI\nReact 18 + TypeScript\n(Single Page Application)" as SPA
    component "Pembuat Berkas\npdfmake, ExcelJS, JSZip\n(dimuat saat dibutuhkan)" as BERKAS
    component "Penyimpanan Token\nlocalStorage" as TOKEN
  }
}

node "Server Hosting cPanel BPS  (Node.js + Express, dijalankan lewat Passenger)" as SERVER {
  component "Penyaji Berkas Statis\n(hasil build SPA)" as STATIS
  component "RESTful API\n/kharisma/api/**" as API
  component "Lapisan Keamanan\nverifikasi token HMAC-SHA256,\ncek peran & kepemilikan data,\npembatasan percobaan login" as AUTH
  component "Lapisan Layanan\nlogika honor, SBML, penomoran surat,\npenilaian, notifikasi" as SERVICE
}

database "Basis Data\nMySQL / MariaDB\n(18 tabel)" as DB

cloud "Penyimpanan Dokumen Instansi\n(Google Drive)" as DRIVE
cloud "Aplikasi SOBAT\n(berkas Excel mitra)" as SOBAT
cloud "Aplikasi FASIH\n(belum tersambung)" as FASIH

SPA -down-> STATIS : memuat halaman\n(HTTPS)
SPA -down-> API : permintaan JSON + token\n(HTTPS)
TOKEN -right-> SPA : menyertakan token\npada setiap permintaan
API -down-> AUTH : setiap permintaan diperiksa
AUTH -down-> SERVICE : permintaan yang lolos
SERVICE -down-> DB : kueri SQL & transaksi\n(kumpulan koneksi)
SERVICE -up-> API : data JSON
BERKAS -left-> SPA : PDF surat,\nrekap Excel/PDF
BROWSER -right-> DRIVE : membuka tautan dokumen
SOBAT -up-> BROWSER : berkas Excel dibaca\nlangsung di peramban
FASIH .up.> API : rencana integrasi progres\n(belum diterapkan)

note right of SERVICE
  Berkas PDF dan Excel dibentuk di
  peramban, bukan di server, sehingga
  beban server tetap ringan.
end note

note bottom of DRIVE
  Sistem hanya menyimpan tautan
  dokumen, berkas aslinya tetap
  berada di penyimpanan instansi.
end note
@enduml
